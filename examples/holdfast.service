# systemd unit for holdfast. Install the binary to /usr/local/bin and the
# config to /etc/holdfast/holdfast.json, then:
#
#   systemctl enable --now holdfast
#
# Stopping it withdraws every route (after graceful_shutdown, if set), so
# TimeoutStopSec must be longer than that.

[Unit]
Description=holdfast anycast route announcer
Documentation=https://github.com/Rakshit-gen/holdfast
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/local/bin/holdfast check -config /etc/holdfast/holdfast.json
ExecStart=/usr/local/bin/holdfast run -config /etc/holdfast/holdfast.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s

DynamicUser=yes
# Port 179 is privileged; this is the only extra right holdfast needs.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/holdfast
# DynamicUser can't read a root-only token file. Hand it over as a
# credential instead and point fleet.token_file at
# /run/credentials/holdfast.service/fleet-token:
# LoadCredential=fleet-token:/etc/holdfast/fleet-token

[Install]
WantedBy=multi-user.target
